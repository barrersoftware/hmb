<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Haven.MemoryBus</PackageId>
    <Version>2.0.0</Version>
    <Authors>Barrer Software;Haven AI</Authors>
    <Description>Haven Memory Bus (HMB) - High-Performance Zero-Copy Direct-Indexed Memory Bus for .NET</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/barrersoftware/hmb</RepositoryUrl>
  </PropertyGroup>

</Project>
